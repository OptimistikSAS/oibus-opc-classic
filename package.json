{
  "name": "@oibus/opc-classic",
  "version": "0.2.0",
  "description": "Windows-only OPC Classic (DA/HDA) driver for OIBus. Spawns and multiplexes connections over a bundled .NET helper (OPC Foundation OpcNetApi/OpcComRcw DCOM interop, MIT) via a stdio JSON protocol.",
  "license": "EUPL-1.2",
  "author": "Optimistik SAS",
  "homepage": "https://github.com/OptimistikSAS/oibus-opc-classic#readme",
  "bugs": "https://github.com/OptimistikSAS/oibus-opc-classic/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimistikSAS/oibus-opc-classic.git"
  },
  "keywords": ["oibus", "opc", "opc-classic", "opc-da", "opc-hda", "dcom", "windows"],
  "os": ["win32"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "runtimes", "THIRD-PARTY-NOTICES.md"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "26.12.1",
    "npm": "11.20.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:win-x64": "dotnet publish -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -p:DebugType=None -o runtimes/win-x64",
    "build:win-x86": "dotnet publish -c Release -r win-x86 --self-contained -p:PublishSingleFile=true -p:DebugType=None -o runtimes/win-x86",
    "build:win-arm64": "dotnet publish -c Release -r win-arm64 --self-contained -p:PublishSingleFile=true -p:DebugType=None -o runtimes/win-arm64",
    "build:runtimes": "npm run build:win-x64 && npm run build:win-x86 && npm run build:win-arm64",
    "test": "node --import tsx --test src/**/*.spec.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
