<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-only helper spawned as a local child process by @oibus/opc-classic's TypeScript driver
    (see src/index.ts) and talked to over a newline-delimited JSON protocol on stdin/stdout. Wraps
    Quick.OpcNetApi/OpcComRcw DCOM interop for OPC Classic DA + HDA.

    Published as a self-contained single-file executable per architecture, e.g. for win-x64:
      dotnet publish -c Release -r win-x64 -p:SelfContained=true -p:PublishSingleFile=true
    (repeat with -r win-x86 and -r win-arm64). The resulting binaries are what get bundled into
    runtimes/<rid>/ and shipped in the npm package — see the "Release" section in README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OIBusOpcClassicWindows</AssemblyName>
    <RootNamespace>OIBusOpcClassicWindows</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Quick.OpcComRcw" Version="2.1.108" />
    <PackageReference Include="Quick.OpcNetApi" Version="2.1.108" />
    <PackageReference Include="Quick.OpcNetApi.Com" Version="2.1.108" />
  </ItemGroup>

</Project>
